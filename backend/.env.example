PORT=3001
# PostgreSQL en Neon. Dos cadenas del panel "Connect":
#  - DATABASE_URL: con "Connection pooling" activado (host con -pooler). La usa la app.
#  - DIRECT_URL:   con "Connection pooling" desactivado. La usan las migraciones de Prisma.
DATABASE_URL="postgresql://USUARIO:CLAVE@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USUARIO:CLAVE@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRA=7d
# Orígenes permitidos para CORS, separados por comas (admite *.vercel.app)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development
# Contraseña inicial que la semilla asigna a las cuentas (si falta, se genera una al azar)
SEED_PASSWORD=elige-una-contrasena
