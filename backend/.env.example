PORT=3001
# PostgreSQL (Neon). En local usa la rama "dev" de Neon; en Render la rama principal.
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST/neondb?sslmode=require"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRA=7d
# Orígenes permitidos para CORS, separados por comas (añade la URL de Vercel en producción)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development
